# ---------------------------------------------------------------
# Makefile khusus macOS (GUI-only).
#
# Pakai file ini (bukan Makefile biasa) di Mac:
#   make -f Makefile.macos deps      # install dependency lewat Homebrew
#   make -f Makefile.macos all       # build GUI
#
# Kalau mau, boleh juga symlink/rename supaya bisa "make" polos:
#   ln -sf Makefile.macos Makefile
# ---------------------------------------------------------------

CXX      := clang++
CXXFLAGS := -std=c++17 -Wall -Wextra -O2
SRCDIR   := src
OBJDIR   := build
DISTDIR  := dist

# Homebrew bisa di /usr/local (Intel) atau /opt/homebrew (Apple Silicon).
# pkg-config dari Homebrew otomatis tahu prefix yang benar selama
# `brew install pkg-config` sudah dijalankan dan PATH sudah benar
# (brew shellenv). Kalau pkg-config belum ada di PATH, jalankan dulu:
#   eval "$(brew shellenv)"
HOMEBREW_PREFIX := $(shell brew --prefix 2>/dev/null)
PKG_CONFIG_PATH := $(HOMEBREW_PREFIX)/lib/pkgconfig

HIDAPI_CFLAGS := $(shell PKG_CONFIG_PATH=$(PKG_CONFIG_PATH) pkg-config --cflags hidapi 2>/dev/null)
HIDAPI_LIBS   := $(shell PKG_CONFIG_PATH=$(PKG_CONFIG_PATH) pkg-config --libs   hidapi 2>/dev/null)
GTK_CFLAGS    := $(shell PKG_CONFIG_PATH=$(PKG_CONFIG_PATH) pkg-config --cflags gtk+-3.0 2>/dev/null)
GTK_LIBS      := $(shell PKG_CONFIG_PATH=$(PKG_CONFIG_PATH) pkg-config --libs   gtk+-3.0 2>/dev/null)

# usb_monitor.cpp di macOS pakai IOKit (bukan libudev seperti di Linux)
FRAMEWORKS := -framework IOKit -framework CoreFoundation

COMMON_SRCS := \
    $(SRCDIR)/relay_controller.cpp \
    $(SRCDIR)/usb_monitor.cpp \
    $(SRCDIR)/device_mapper.cpp \
    $(SRCDIR)/app_core.cpp

GUI_SRCS := $(COMMON_SRCS) $(SRCDIR)/gui_ui.cpp $(SRCDIR)/main.cpp
GUI_LIBS := $(HIDAPI_LIBS) $(FRAMEWORKS) $(GTK_LIBS)

TARGET_GUI := usbrelay-gui

.PHONY: all gui clean deps dist-assets

all: gui

dist-assets:
	@mkdir -p $(OBJDIR) $(DISTDIR)
	@cp -r config $(DISTDIR)/ 2>/dev/null || true

gui: dist-assets $(GUI_SRCS)
	$(CXX) $(CXXFLAGS) $(HIDAPI_CFLAGS) $(GTK_CFLAGS) -DUSE_GUI \
		-o $(DISTDIR)/$(TARGET_GUI) $(GUI_SRCS) $(GUI_LIBS)
	@echo "==> Build GUI selesai: $(DISTDIR)/$(TARGET_GUI)"

# Install dependency lewat Homebrew (https://brew.sh)
deps:
	brew install hidapi gtk+3 pkg-config

clean:
	rm -rf $(OBJDIR) $(DISTDIR)